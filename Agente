<!DOCTYPE html>
<html>
  <head>
    <script src="https://aframe.io/releases/1.4.0/aframe.min.js"></script>
  </head>
  <body>
    <a-scene>
      <!-- Cámara -->
      <a-entity position="0 1.6 4">
        <a-camera></a-camera>
      </a-entity>

      <!-- Agente virtual -->
      <a-entity id="agente" position="0 1 -3">
        <a-gltf-model src="agente.glb"></a-gltf-model>
      </a-entity>

      <!-- Suelo -->
      <a-plane rotation="-90 0 0" width="10" height="10" color="gray"></a-plane>
      
      <!-- Iluminación -->
      <a-light type="directional" intensity="1.5" position="0 3 1"></a-light>
    </a-scene>
  </body>
</html>
